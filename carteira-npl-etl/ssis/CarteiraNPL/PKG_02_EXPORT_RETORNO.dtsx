                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT cd_cedente, nu_contrato, nu_documento,
       ds_situacao, cd_erros, ds_motivos
  FROM exp.vw_retorno_lote
 WHERE id_lote = (SELECT MAX(id_lote) FROM ctl.lote WHERE ds_status = 'CARREGADO')
 ORDER BY ds_situacao DESC, nu_contrato;</property>
